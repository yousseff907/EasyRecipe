sub_filter_once off;
sub_filter_types text/plain text/xml application/xml;
sub_filter '__SITE_DOMAIN__' '${SITE_DOMAIN}';
sub_filter '__CONTACT_EMAIL__' '${CONTACT_EMAIL}';
sub_filter '__GOOGLE_CLIENT_ID__' '${GOOGLE_CLIENT_ID}';
sub_filter '__TURNSTILE_SITE_KEY__' '${TURNSTILE_SITE_KEY}';

location ~ \.php$ {
	return 302 https://www.youtube.com/watch?v=dQw4w9WgXcQ;
}

location ~ /\.env {
	return 302 https://www.youtube.com/watch?v=dQw4w9WgXcQ;
}

location ~ /(wp-admin|wp-content|wp-includes|vendor|phpunit) {
	return 302 https://www.youtube.com/watch?v=dQw4w9WgXcQ;
}

location ~ docker-compose {
	return 302 https://www.youtube.com/watch?v=dQw4w9WgXcQ;
}

location /cgi-bin/ {
	return 444;
}

error_page 404 /404.html;
error_page 500 502 503 504 /404.html;

location = /404.html {
	root /usr/share/nginx/html;
	internal;
}

location = /r/ {
	root /usr/share/nginx/html;
	try_files /r.html =404;
}

location /r/ {
	proxy_pass http://backend:8000;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_intercept_errors on;
}

location /user/ {
	root /usr/share/nginx/html;
	try_files /profile.html =404;
}

location / {
	root /usr/share/nginx/html;
	index login.html;
	try_files $uri $uri.html $uri/ =404;
}

location /api/ {
	proxy_pass http://backend:8000;
	proxy_read_timeout 300s;
	proxy_send_timeout 300s;
	proxy_connect_timeout 300s;
	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
}
location = /service-worker.js {
	root /usr/share/nginx/html;
	add_header Cache-Control "no-cache";
}
